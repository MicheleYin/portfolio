---
import ThemeSelector from "./ThemeSelector.astro";

const tabs = [
  { id: "home", label: "Home" },
  { id: "projects", label: "Projects" },
  { id: "publications", label: "Publications" },
  { id: "work", label: "Work" },
  { id: "education", label: "Education" },
  { id: "contact", label: "Contact" },
];
const homePath = Astro.url.pathname === "/" ? "" : "/";
---

<nav
  class="glass-nav mx-3 mt-3 max-w-6xl rounded-2xl px-4 py-3 pr-16 sm:mx-6 lg:mx-auto"
  aria-label="Portfolio sections"
  data-glass-header
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4">
    <a href={`${homePath}#home`} class="hidden text-sm font-semibold tracking-wide sm:block">MY</a>
    <div class="tabs tabs-boxed min-w-0 max-w-full gap-1 overflow-x-auto bg-base-200/55 p-1">
      {tabs.map((tab, index) => (
        <a
          href={`${homePath}#${tab.id}`}
          class:list={["tab whitespace-nowrap", { "tab-active": index === 0 }]}
          data-section-tab={tab.id}
        >
          {tab.label}
        </a>
      ))}
    </div>
    <div class="flex shrink-0 items-center gap-2">
      <label class="glass-control flex items-center gap-2 px-2 py-2" title="Adjust glass intensity">
        <span class="sr-only">Glass intensity</span>
        <input
          type="range"
          min="0"
          max="100"
          value="55"
          class="h-1 w-16 cursor-pointer accent-primary sm:w-24"
          data-glass-slider
          aria-label="Glass intensity"
        />
      </label>
      <ThemeSelector />
    </div>
  </div>

  <svg aria-hidden="true" class="pointer-events-none absolute h-0 w-0">
    <filter id="portfolio-liquid-glass-filter" x="-20%" y="-20%" width="140%" height="140%">
      <feTurbulence type="fractalNoise" baseFrequency="0.018" numOctaves="2" seed="7" result="liquidNoise" />
      <feDisplacementMap in="SourceGraphic" in2="liquidNoise" scale="16" xChannelSelector="R" yChannelSelector="G" />
    </filter>
  </svg>
</nav>

<script>
  const glassHeader = document.querySelector<HTMLElement>("[data-glass-header]");
  const glassSlider = document.querySelector<HTMLInputElement>("[data-glass-slider]");
  const displacementMap = document.querySelector<SVGElement>("#portfolio-liquid-glass-filter feDisplacementMap");

  const setGlassStrength = (value: number) => {
    if (!glassHeader || !glassSlider) return;

    glassSlider.value = String(value);
    const root = document.documentElement;
    root.style.setProperty("--glass-opacity", String(0.18 + value * 0.0072));
    root.style.setProperty("--glass-blur", `${4 + value * 0.14}px`);
    root.style.setProperty("--glass-white-a", `${30 + value * 0.36}%`);
    root.style.setProperty("--glass-accent-a", `${value * 0.12}%`);
    root.style.setProperty("--glass-white-b", `${20 + value * 0.22}%`);
    displacementMap?.setAttribute("scale", String(value * 0.28));
    localStorage.setItem("portfolio-glass-strength", String(value));
  };

  const savedGlassStrength = Number(localStorage.getItem("portfolio-glass-strength"));
  setGlassStrength(Number.isFinite(savedGlassStrength) ? savedGlassStrength : 55);
  glassSlider?.addEventListener("input", (event) => {
    setGlassStrength(Number((event.target as HTMLInputElement).value));
  });

  const tabs = document.querySelectorAll<HTMLAnchorElement>("[data-section-tab]");
  const sections = [...tabs]
    .map((tab) => document.getElementById(tab.dataset.sectionTab ?? ""))
    .filter((section): section is HTMLElement => section !== null);

  const setActiveTab = (id: string) => {
    tabs.forEach((tab) => tab.classList.toggle("tab-active", tab.dataset.sectionTab === id));
  };

  const observer = new IntersectionObserver(
    (entries) => {
      const visible = entries
        .filter((entry) => entry.isIntersecting)
        .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
      if (visible) setActiveTab(visible.target.id);
    },
    { rootMargin: "-20% 0px -65% 0px", threshold: [0.1, 0.5, 1] },
  );

  sections.forEach((section) => observer.observe(section));
</script>